# --- Banco de dados ---
DATABASE_URL="postgresql://estudio:estudio_dev_local@localhost:5432/estudio_digital"
REDIS_URL="redis://localhost:6379"

# --- Anthropic (Orchestrator) ---
ANTHROPIC_API_KEY=
# Modelo usado para extração de slots / roteamento (barato, rápido)
MODEL_EXTRACTION="claude-haiku-4-5-20251001"
# Modelo usado para geração da resposta conversacional (mais forte)
MODEL_CONVERSATION="claude-sonnet-5"

# --- WhatsApp Cloud API (Meta) # --- Banco de dados ---
DATABASE_URL="postgresql://estudio:estudio_dev_local@localhost:5432/estudio_digital"
REDIS_URL="redis://localhost:6379"

# --- Orchestrator: seleção de provider ---
# "anthropic" (padrão, custo real) ou "free" (Groq/OpenRouter, zero custo — fase de teste)
MODEL_PROVIDER="free"

# --- Anthropic (usado quando MODEL_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=""
MODEL_EXTRACTION="claude-haiku-4-5-20251001"
MODEL_CONVERSATION="claude-sonnet-5"

# --- Provider gratuito (usado quando MODEL_PROVIDER=free) ---
# Groq:       FREE_PROVIDER_BASE_URL="https://api.groq.com/openai/v1"
# OpenRouter: FREE_PROVIDER_BASE_URL="https://openrouter.ai/api/v1"
FREE_PROVIDER_BASE_URL="https://openrouter.ai/api/v1"
FREE_PROVIDER_API_KEY=""
FREE_PROVIDER_MODEL="openrouter/free"

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""

# --- App ---
PORT=3333
WEB_APP_BASE_URL="http://localhost:5173"
NODE_ENV="development"
